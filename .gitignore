# =====================================================================
# MoxMate — publication .gitignore
# Local-only, secret, and agent/operational paths are NEVER published.
# (GitHub Publication Standard §7.)
# =====================================================================

# --- Dot-directories (agent workspaces, caches, venvs) are local.
# --- The public community/CI directory `.github/` is the exception.
.[!.]*/
..?*/
!.github/

# --- Secrets and local configuration (never commit) ---
.env
.env.demo
.env.r6ctl
.env.r7ctl
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.yaml
secrets.yml
.qwenignore

# --- Real (non-example) configuration ---
config/config.yaml
config/demo.yaml

# --- Worker runtime heartbeat (runtime file in storage.root) ---
.worker-heartbeat

# --- Data and working areas (local only) ---
cache/
input/
jobs/
output/
working/
backups/
books/
logs/
data/
*.db
*.db-wal
*.db-shm
**/.covers/

# --- Agent / local AI tooling (never publish) ---
.agent/
.agents/
.a/
.qwen/
.claude/
.cursor/
*.agent.md

# --- Terminal sessions / multiplexers / distributed-agent runtime ---
*.tmux
*.tmux.log
tmux-client-*
tmux-server-*
screenlog.*
*.screenlog
zellij-dump*
nohup.out
*.cast
tmux-sessions/
terminal-dumps/
.queue/
.runs/
gpu-pool/

# --- Internal engineering docs (acceptance evidence, screenshots, handoffs)
# --- are local-only and intentionally not published.
docs/CONTROL/
docs/design/
docs/HANDOFF.md
docs/UI_HANDOFF.md
docs/ENGINE_PROBE.md
docs/MTPE_BASELINE.md
docs/DECISIONS.md

# --- Author-specific test that exercises a private tailnet stand (no public
# --- value; the values are the publisher's own overlay network).
tests/v111_tailnet.py

# --- Owner-managed UI rule declaration (lives locally, not in git) ---
ui-rules.yaml

# --- Python ---
.venv/
.venv-anki/
.venv-u3browser/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
