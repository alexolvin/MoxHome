{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "card_schema.nl",
  "title": "Словарная карточка nl (L1.6): обязательные поля зависят от языка и части речи",
  "type": "object",
  "additionalProperties": false,
  "required": ["lemma", "word_form", "pos", "meaning", "translation", "example", "segment_id", "frequency_band", "cefr_level", "cefr_source"],
  "properties": {
    "lemma": {"type": "string", "minLength": 1},
    "word_form": {"type": "string", "minLength": 1},
    "pos": {"enum": ["noun", "verb", "adjective"]},
    "meaning": {"type": "string", "minLength": 1},
    "translation": {"type": "string", "minLength": 1},
    "example": {"type": "string", "minLength": 1},
    "segment_id": {"type": "string", "minLength": 1},
    "frequency_band": {"enum": ["A1", "A2", "B1", "B2", "C1", "C2"]},
    "cefr_level": {"enum": ["A1", "A2", "B1", "B2", "C1", "C2"]},
    "cefr_source": {"type": "string", "minLength": 1},
    "article": {"enum": ["de", "het"]},
    "plural": {"type": "string", "minLength": 1},
    "diminutive": {"type": ["string", "null"]},
    "auxiliary": {"enum": ["hebben", "zijn"]},
    "participle": {"type": "string", "minLength": 1},
    "separable": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"pos": {"const": "noun"}}, "required": ["pos"]},
      "then": {"required": ["article", "plural", "diminutive"]}
    },
    {
      "if": {"properties": {"pos": {"const": "verb"}}, "required": ["pos"]},
      "then": {"required": ["auxiliary", "participle", "separable"]}
    }
  ]
}
