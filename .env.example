# EpubTranslator — пример .env (секреты и адреса).
# Реальный .env НЕ коммитится (см. .gitignore).
# Установка: cp .env.example .env && заполнить.

# --- LLM-эндпоинт (OpenAI-совместимый: vLLM, Ollama, ...) ---
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=example-model
LLM_API_KEY=

# Опциональные переопределения для профиля analysis (T-E4-8):
# LLM_ANALYSIS_BASE_URL=
# LLM_ANALYSIS_MODEL=
# LLM_ANALYSIS_API_KEY=

# --- Сервер ---
# Адрес бинда. 0.0.0.0 разрешён только с ALLOW_WILDCARD_BIND=true (E0.6).
SERVER_BIND_ADDRESS=127.0.0.1
# ALLOW_WILDCARD_BIND=
# Общий секрет доступа к API/UI (этап U1):
# SERVER_AUTH_SECRET=
