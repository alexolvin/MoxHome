# MoxMate — пример .env (только секреты и адрес бинда).
# E4.1: адреса и модели LLM задаются ТОЛЬКО в YAML-профилях
# (config/config.yaml, llm.profiles.*.base_url / .model) — здесь их нет.
# Реальный .env НЕ коммитится (см. .gitignore).
# Установка: cp .env.example .env && заполнить.

# --- API-ключи LLM (OpenAI-совместимый эндпоинт: vLLM, Ollama, ...) ---
# Ключ для профилей translation и fill:
LLM_API_KEY=
# Опционально: отдельный ключ для профиля analysis (T-E4-8);
# если пусто — используется LLM_API_KEY:
# LLM_ANALYSIS_API_KEY=

# --- Сервер ---
# Адрес бинда. 0.0.0.0 разрешён только с ALLOW_WILDCARD_BIND=true (E0.6).
SERVER_BIND_ADDRESS=127.0.0.1
# ALLOW_WILDCARD_BIND=
# Общий секрет доступа к API/UI (этап U1):
# SERVER_AUTH_SECRET=
