PROFILES_DIRECTORY: str

class Language:
    """Язык с вероятностью: `lang` — код (en, de, …), `prob` — вероятность."""

    lang: str
    prob: float

    def __init__(self, lang: str, prob: float) -> None: ...
    def __repr__(self) -> str: ...
    def __lt__(self, other: object) -> bool: ...

class Detector:
    """Детектор языка; создаётся через DetectorFactory.create()."""

    def append(self, text: str) -> None: ...
    def detect(self) -> str: ...
    def get_probabilities(self) -> list[Language]: ...

class DetectorFactory:
    """Фабрика детекторов. seed — класс.атрибут; set_seed() — фиксация (детерминированность)."""

    seed: int | None

    def __init__(self) -> None: ...
    def load_profile(self, profile_directory: str) -> None: ...
    def create(self, alpha: float | None = None) -> Detector: ...
    def set_seed(self, seed: int) -> None: ...
    def get_lang_list(self) -> list[str]: ...

def detect(text: str) -> str: ...
def detect_langs(text: str) -> list[Language]: ...
